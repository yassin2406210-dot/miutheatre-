<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>MIU Theatre Club</title>
  <%- include('../partials/global_styles') %>
  <link rel="stylesheet" href="/css/base.css"/>
  <link rel="stylesheet" href="/css/navbar.css"/>
  <link rel="stylesheet" href="/css/home.css"/>
  <link rel="stylesheet" href="/css/pages.css"/>
  <link rel="stylesheet" href="/css/forms.css"/>
  <link rel="stylesheet" href="/css/admin.css"/>
</head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/mobile-menu') %>
<%- include('../partials/toast') %>

<section class="page-hero">
  <div class="container">
    <span class="section-tag">Contact</span>
    <h1>Get in <em>Touch</em></h1>
    <p>Have a question or want to know more about the club? We'd love to hear from you.</p>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">
    <div class="contact-info">
      <h2>We're Here for You</h2>
      <p>Whether you're a new student curious about joining or a current member with questions — reach out and we'll get back to you within 1–2 business days.</p>
      <div class="info-card"><div class="info-icon">📍</div><div><h4>Location</h4><p>Misr International University, Cairo</p></div></div>
      <div class="info-card"><div class="info-icon">✉️</div><div><h4>Email</h4><p>theatreclub@miuegypt.edu.eg</p></div></div>
      <div class="info-card"><div class="info-icon">🕐</div><div><h4>Office Hours</h4><p>Sunday – Thursday: 10:00 AM – 4:00 PM</p></div></div>
    </div>
    <div class="form-card">
      <h2>Send Us a Message</h2>
      <p>Fill in the form and a team member will respond within 1–2 business days.</p>
      <div id="contactAlert" class="alert" style="display:none"></div>
      <div class="form-row-2">
        <div class="form-group"><label for="ctFirstName">First Name *</label><input type="text" id="ctFirstName" placeholder="Sara" required/></div>
        <div class="form-group"><label for="ctLastName">Last Name</label><input type="text" id="ctLastName" placeholder="Ahmed"/></div>
      </div>
      <div class="form-group"><label for="ctEmail">MIU Email *</label><input type="email" id="ctEmail" placeholder="yourname@miuegypt.edu.eg" required/></div>
      <div class="form-group">
        <label for="ctSubject">Subject</label>
        <select id="ctSubject">
          <option value="">Select a topic...</option>
          <option>Joining the Club</option>
          <option>Auditions</option>
          <option>Workshops</option>
          <option>Script Submission</option>
          <option>General Inquiry</option>
          <option>Other</option>
        </select>
      </div>
      <div class="form-group"><label for="ctMessage">Message *</label><textarea id="ctMessage" placeholder="Write your message here..." required></textarea></div>
      <button class="btn-red full-width" id="ctBtn" onclick="submitContact()">Send Message</button>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
<script src="/js/web.js"></script>
</body>
</html>
